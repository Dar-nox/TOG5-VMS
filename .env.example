# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings → API
#
# Both of these are safe in the browser. The anon key is designed to be public;
# row level security is what actually protects the data, not secrecy of the key.
#
# The database password is NOT here and must never be committed. It is only
# needed to push migrations, and it belongs in your shell for that one command.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Nothing else is needed here. The VAPID public key for push notifications lives
# in `.env`, which is committed: it ships inside the bundle whatever we do, so
# there is nothing to protect and every build gets it without a dashboard
# setting somebody has to remember.
