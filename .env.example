# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings → API
#
# Both of these are safe in the browser. The anon key is designed to be public;
# row level security is what actually protects the data, not secrecy of the key.
#
# The database password is NOT here and must never be committed. It is only
# needed to push migrations, and it belongs in your shell for that one command.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# The public half of the VAPID keypair, for push notifications. Also safe in the
# browser — it is what the push service checks a message was signed by, and the
# private half never leaves the Edge Function's secrets.
#
# Generate the pair with:  npx web-push generate-vapid-keys
#
# Vite bakes this in at build time, so it has to be set wherever the site is
# built, not just locally. Without it the notifications toggle stays hidden and
# nothing else breaks.
VITE_VAPID_PUBLIC_KEY=
