{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TOG 5 VMS",
  "version": "0.1.0",
  "identifier": "com.tog5.vms",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TOG 5 VMS",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
